{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @cuadreapp/pwa build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @cuadreapp/pwa start",
    "healthcheckPath": "/salud",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
