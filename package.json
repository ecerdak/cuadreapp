{
  "name": "cuadreapp",
  "version": "0.0.0",
  "private": true,
  "description": "Control de despacho de combustible en planta de clientes industriales de Lubryco S.A.S.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint apps packages",
    "formato": "prettier --write .",
    "formato:verificar": "prettier --check .",
    "fronteras": "depcruise apps packages",
    "sin-clientes": "node scripts/sin-nombres-de-cliente.mjs",
    "verificar": "pnpm lint && pnpm formato:verificar && pnpm fronteras && pnpm sin-clientes && pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.19.0"
  }
}
